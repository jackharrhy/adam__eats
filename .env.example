# Generate this with: pnpm emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# The public HTTPS origin used in invites, magic links, and recovery emails.
EMDASH_SITE_URL=https://eats.example.com

# Create an API key and verify the sender domain at https://resend.com.
RESEND_API_KEY=re_replace_me
RESEND_FROM="Adam Eats <hello@eats.example.com>"
RESEND_REPLY_TO=
