{
  "name": "adam__eats",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.0.0-rc.6",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "seed:generate": "node scripts/generate-seed.mjs",
    "typecheck": "astro check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --ignore-path .gitignore && prettier --write .",
    "format:check": "oxfmt --ignore-path .gitignore --check && prettier --check .",
    "knip": "knip --no-exit-code --exclude unlisted,unresolved,exports,types,duplicates"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.2",
    "@astrojs/react": "^6.0.2",
    "@cooklang/cooklang": "^0.18.7",
    "astro": "^7.2.2",
    "better-sqlite3": "^12.11.1",
    "emdash": "^0.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "knip": "^6.32.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
